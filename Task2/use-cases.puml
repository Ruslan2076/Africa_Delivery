@startuml use-cases
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
left to right direction
title Africa Delivery — ключевые сценарии MVP (15.10)

actor "Покупатель" as Buyer
actor "Продавец" as Seller
actor "Оператор\nбэк-офиса" as Operator
actor "Руководство" as CEO
actor "Платёжный\nпартнёр" as PSP <<система>>
actor "Логистический\nпартнёр" as Logistics <<система>>
actor "SMS / WhatsApp" as Msg <<система>>

rectangle "Africa Delivery Platform" {
  usecase "UC-01 Найти товар\nв каталоге" as UC01
  usecase "UC-02 Открыть карточку\nпо диплинку из рекламы" as UC02
  usecase "UC-03 Оформить заказ" as UC03
  usecase "UC-04 Оплатить заказ\n(M-Pesa, Flutterwave)" as UC04
  usecase "UC-05 Отследить статус\nв личном кабинете" as UC05
  usecase "UC-06 Дать или отозвать\nсогласие на рассылки" as UC06
  usecase "UC-07 Запросить возврат" as UC07
  usecase "UC-08 Подтвердить заказ\nи передать в доставку" as UC08
  usecase "UC-09 Получить выплату\nв тот же день" as UC09
  usecase "UC-10 Верифицировать продавца\n(KYC)" as UC10
  usecase "UC-11 Загрузить и промодерировать\nтовары (5 000 SKU)" as UC11
  usecase "UC-12 Обработать возврат" as UC12
  usecase "UC-13 Смотреть дашборд запуска" as UC13
  usecase "UC-14 Отправить уведомление\nо статусе (SMS, WhatsApp)" as UCN
}

Buyer --> UC01
Buyer --> UC02
Buyer --> UC03
Buyer --> UC05
Buyer --> UC06
Buyer --> UC07
UC03 ..> UC04 : <<include>>
UC03 ..> UCN : <<include>>
UC08 ..> UCN : <<include>>

Seller --> UC08
Seller --> UC09
Operator --> UC10
Operator --> UC11
Operator --> UC12
CEO --> UC13

UC04 --> PSP
UC09 --> PSP
UC08 --> Logistics
UCN --> Msg
@enduml
